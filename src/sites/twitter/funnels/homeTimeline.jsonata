---
name: "Home Timeline"
method: POST
url: "/i/api/graphql/*/HomeTimeline"
---
[
  /* Extract tweets from the timeline */
  data.home.home_timeline_urt.instructions[].entries[].content.itemContent.tweet_results.result.{
    "_entity": "@twitter/tweet",
    "_id": legacy.id_str,
    "text": legacy.full_text,
    "likeCount": legacy.favorite_count,
    "retweetCount": legacy.retweet_count,
    "replyCount": legacy.reply_count,
    "author": $ref(core.user_results.result.rest_id),
    "_createdAt": $timestamp(legacy.created_at)
  },
  /* Extract retweeted tweets if present */
  data.home.home_timeline_urt.instructions[].entries[].content.itemContent.tweet_results.result.retweeted_status_result.result.{
    "_entity": "@twitter/tweet",
    "_id": legacy.id_str,
    "text": legacy.full_text,
    "likeCount": legacy.favorite_count,
    "retweetCount": legacy.retweet_count,
    "replyCount": legacy.reply_count,
    "author": $ref(core.user_results.result.rest_id),
    "_createdAt": $timestamp(legacy.created_at)
  },
  /* Extract users from the timeline */
  data.home.home_timeline_urt.instructions[].entries[].content.itemContent.tweet_results.result.core.user_results.result.{
    "_entity": "@twitter/user",
    "_id": rest_id,
    "username": core.screen_name,
    "nickname": core.name,
    "profilePic": $image(avatar.image_url),
    "followerCount": legacy.followers_count,
    "followingCount": legacy.friends_count,
    "tweetCount": legacy.statuses_count,
    "isVerified": is_blue_verified,
    "isProtected": privacy.protected,
    "bio": profile_bio.description,
    "_createdAt": $timestamp(core.created_at)
  },
  /* Extract retweeted users if present */
  data.home.home_timeline_urt.instructions[].entries[].content.itemContent.tweet_results.result.retweeted_status_result.result.core.user_results.result.{
    "_entity": "@twitter/user",
    "_id": rest_id,
    "username": core.screen_name,
    "nickname": core.name,
    "profilePic": $image(avatar.image_url),
    "followerCount": legacy.followers_count,
    "followingCount": legacy.friends_count,
    "tweetCount": legacy.statuses_count,
    "isVerified": is_blue_verified,
    "isProtected": privacy.protected,
    "bio": profile_bio.description,
    "_createdAt": $timestamp(core.created_at)
  }
]
