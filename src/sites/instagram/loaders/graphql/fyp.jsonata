data.xdt_api__v1__feed__timeline__connection.edges.node.explore_story.media ?
[
  data.xdt_api__v1__feed__timeline__connection.edges.node.explore_story.media.{
    "_entity": "@instagram/post",
    "_id": id,
    "_createdAt": $timestamp(taken_at),
    "title": caption.text,
    "media": carousel_media ? {
      "kind": "carousel",
      "images": carousel_media[]@$M.(
        image_versions2.candidates[0].(
          $image(url) ~> $with_dimensions(width, height) ~> $unique_id($M.pk)
        )
      )
    } : video_versions ? {
      "kind": "video",
      "video": video_versions[0].($video(url) ~> $with_dimensions(width, height))
    } : image_versions2 ? {
      "kind": "image",
      "image": $image(image_versions2.candidates[0].url) ~> $with_dimensions(image_versions2.candidates[0].width, image_versions2.candidates[0].height)
    },
    "commentsDisabled": comments_disabled,
    "likeCount": like_count,
    "author": $ref("@instagram/user", user.id),
    "likedBy": facepile_top_likers[].$ref("@instagram/user", id)
  },

  data.xdt_api__v1__feed__timeline__connection.edges.node.explore_story.media.user.{
    "_entity": "@instagram/user",
    "_id": id,
    "username": username,
    "nickname": full_name,
    "profilePic": $image(profile_pic_url),
    "isPrivate": is_private,
    "isVerified": is_verified
  },

  data.xdt_api__v1__feed__timeline__connection.edges.node.explore_story.media.usertags.in.user.{
    "_entity": "@instagram/user",
    "_id": id,
    "username": username,
    "nickname": full_name,
    "profilePic": $image(profile_pic_url),
    "isVerified": is_verified
  }
]
