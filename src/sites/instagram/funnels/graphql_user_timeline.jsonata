---
method: POST
url: "/graphql/query"
---
data.xdt_api__v1__feed__user_timeline_graphql_connection.edges.node[pk]
  /* some false positives without this
  and $request.headers.`x-root-field-name` = "xdt_api__v1__feed__user_timeline_graphql_connection" */ ?
[
  data.xdt_api__v1__feed__user_timeline_graphql_connection.edges.node.{
    "_entity": "@instagram/post",
    "_id": pk,
    "_createdAt": $timestamp(taken_at),
    "title": caption.text,
    "media": video_versions ? {
      "kind": "video",
      "video": $video(video_versions[0].url) ~> $with_dimensions(video_versions[0].width, video_versions[0].height)
    } : carousel_media ? {
      "kind": "carousel",
      "images": carousel_media[]@$M.(
        image_versions2.candidates[0].(
          $image(url) ~> $with_dimensions(width, height) ~> $unique_id($M.pk)
        )
      )
    } : image_versions2 ? {
      "kind": "image",
      "image": $image(image_versions2.candidates[0].url) ~> $with_dimensions(image_versions2.candidates[0].width, image_versions2.candidates[0].height)
    },
    "commentsDisabled": comments_disabled ?? false,
    "likeCount": like_count,
    "author": $ref($string(user.pk))
  },

  data.xdt_api__v1__feed__user_timeline_graphql_connection.edges.node.user.{
    "_entity": "@instagram/user",
    "_id": id,
    "username": username,
    "nickname": full_name,
    "profilePic": $image(profile_pic_url),
    "isPrivate": is_private,
    "isVerified": is_verified
  },

  data.xdt_api__v1__feed__user_timeline_graphql_connection.edges.node.facepile_top_likers.{
    "_entity": "@instagram/user",
    "_id": id,
    "username": username,
    "profilePic": $image(profile_pic_url)
  }
]
