---
name: "Search Results"
url: "/*"
---
[
  $$(.searchResultsItem:not(.nativeAd)) {
    "_entity": "@sahibinden/listing",
    "_id": $ | data("id"),
    "_createdAt": $(.searchResultsDateValue)?
      | text
      | trim
      | date(locale: "tr", format: "d MMMM yyyy"),
    "agency": $(a.titleIcon)?
      | attr("href")
      | regex("https:?//(.+).sahibinden.com", 1)
      | ref,
    "name": $(a.classifiedTitle) | text | trim,
    // may not exist for all tables
    "thumbnail": $(.searchResultsLargeThumbnail img:not(.searchResultThumbnailPlaceholder))?
      | media,
    "location": $(.searchResultsLocationValue)?
      | lines { "city": $ | at(0), "district": $ | at(1) },
    "price": $(.searchResultsPriceValue) | innerText | money,
    "attributes": zip(@$$(#searchResultsTable thead td:nth-child(n + 2)), $$(td:nth-child(n + 2))) {
      [$1 | text | trim]: $2 | innerText | trim
    }
      | merge
  },
  $$(.searchResultsItem a.titleIcon) {
    "_entity": "@sahibinden/agency",
    "_id": $ | attr("href") | regex("https?://(.+).sahibinden.com", 1),
    "name": $ | attr("title"),
    "link": $ | attr("href")
  }
]
