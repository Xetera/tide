---
name: "Map Hover"
method: GET
url: "/ajax/mapSearch/classified/markers/*"
---
[
  /* Map the main listing entity */
  {
    "_entity":  "@sahibinden/listing",
    "_id": $string(id),
    "name": title,
    "price": price,
    "latitude": lat,
    "longitude": lon,
    "attributes": attributes
  }
]
