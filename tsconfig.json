{
  "compilerOptions": {
    "incremental": false,
    "noImplicitAny": true,
    "target": "es2021",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["DOM", "ESNext"],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "~gleam/*": ["gleam/build/dev/javascript/tide_shared/*"],
      "~/*": ["src/*"],
      "~/funnels/funnel-loader": ["src/funnels/funnel-loader.vite.ts"]
    },
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vitest/jsdom"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "exclude": ["dist", "node_modules"]
}
