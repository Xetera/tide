HTMLegy {
  Expr
    = Array
    | Object
    | Match
    | FallbackExpr
    | Literal

  FuncCall = ident "(" Expr ("," FuncArg)* ","? ")"

  FuncArg
    = PipeArg  -- pipe
    | Expr     -- expr

  Array = "[" ListOf<Expr, ","?> ","? "]"

  Object = "{" ListOf<Field, ","?> ","? "}"

  Field
    = "[" FallbackExpr "]" ":" Expr  -- dynamic
    | stringLit ":" Expr              -- static
    | "(" FallbackExpr ")"            -- expr

  Match
    = "match" SingleSelector "{" ScopedMatchArm* "}"   -- scoped
    | "match" MatchScrutinee "{" ListOf<ExprMatchArm, ","> ","? "}"  -- expr
    | "match" "{" ListOf<MatchArm, ","> ","? "}"       -- plain

  MatchScrutinee = MatchChain ("??" MatchChain)?

  MatchChain = Source MatchChainStep*

  MatchChainStep
    = PipeTransform
    | Conditional
    | ScopedExpr

  ScopedMatchArm
    = FuncCall "=>" Expr  -- call
    | ident    "=>" Expr  -- fallback

  ExprMatchArm
    = Literal "=>" Expr                     -- literal
    | "_" "=>" Expr                          -- fallback
    | ArmPipeStep ChainStep* "=>" Expr      -- pipe

  ArmPipeStep
    = ident "(" ListOf<PipeArg, ","> ")"  -- call
    | ident                                -- bare

  MatchArm
    = EachSelector   "=>" Expr  -- each
    | SingleSelector "=>" Expr  -- selector
    | ident "=>" Expr           -- fallback

  FallbackExpr = Chain ("??" Chain)?

  Chain = Source ChainStep*

  Source
    = "watch" Source                                       -- watch
    | "await" "(" selectorBody ")" Source                 -- awaitCond
    | "await" Source                                       -- awaitSelf
    | "@" ident EachSelector                              -- aliasEach
    | "@" ident SingleSelector                            -- aliasSingle
    | "@" EachSelector                                    -- rootEach
    | "@" SingleSelector                                  -- rootSingle
    | "@" ident                                           -- aliasRef
    | "@" ~alnum                                          -- rootRef
    | EachSelector
    | SingleSelector
    | PositionalRef
    | ContextRef
    | FuncCall                                            -- funcCall
    | Literal                                             -- literal
  ContextRef = "$" ~"$" ~"(" ~alnum ~digit
  PositionalRef = "$" digit+

  EachSelector   = "$$" "(" selectorBody ")" "+"?
  SingleSelector = "$"  "(" selectorBody ")" (~"??" "?")?

  selectorBody = selectorChar*
  selectorChar =
    "\"" (~"\"" any)* "\""     -- doubleStr
    | "'" (~"'" any)* "'"        -- singleStr
    | "(" selectorBody ")"       -- nested
    | ~")" any                   -- other

  ChainStep
    = PipeTransform
    | Block
    | Conditional
    | ScopedExpr

  ScopedExpr = ".(" Expr ")"

  Block = "{" ListOf<Field, ","?> ","? "}"

  PipeTransform
    = "|" "jsonata" "(" jsonataBody ")"          -- jsonata
    | "|" ident ("(" ListOf<PipeArg, ","> ")")?  -- generic

  jsonataBody = jsonataChar*
  jsonataChar =
    "\"" (~"\"" any)* "\""     -- doubleStr
    | "'" (~"'" any)* "'"        -- singleStr
    | "(" jsonataBody ")"        -- nested
    | ~")" any                   -- other

  PipeArg
    = ident ":" stringLit  -- kwarg
    | ident ":" integer    -- kwargInt
    | ident ":" Chain      -- kwargExpr
    | stringLit            -- string
    | integer              -- integer
    | ident                -- ident

  Conditional
    = ~"??" "?" Expr ":" Expr  -- full
    | ~"??" "?" Expr           -- partial

  Literal
    = stringLit  -- string
    | number     -- number
    | "null"     -- null
    | "true"     -- true
    | "false"    -- false

  stringLit
    = "\"" doubleStringChar* "\""  -- double
    | "'" singleStringChar* "'"    -- single

  doubleStringChar
    = "\\" any   -- escaped
    | ~"\"" any  -- other

  singleStringChar
    = "\\" any  -- escaped
    | ~"'" any  -- other

  number  (a number)  = digit+
  integer (an integer) = digit+

  ident = (letter | "_") (alnum | "_" | "-")*

  space += "//" (~"\n" any)*  -- lineComment
}
