HTMLegy {
  Expr
    = Array
    | Object
    | Match
    | FallbackExpr
    | Literal

  FuncCall = ident "(" Expr ("," PipeArg)* ","? ")"

  Array = "[" ListOf<Expr, ","?> ","? "]"

  Object = "{" ListOf<Field, ","?> ","? "}"

  Field
    = "[" FallbackExpr "]" ":" Expr  -- dynamic
    | stringLit ":" Expr              -- static
    | "(" FallbackExpr ")"            -- expr

  Match
    = "match" SingleSelector "{" ScopedMatchArm* "}"  -- scoped
    | "match" "{" MatchArm* "}"                        -- plain

  ScopedMatchArm
    = FuncCall "=>" Expr  -- call
    | ident    "=>" Expr  -- fallback

  MatchArm
    = EachSelector   "=>" Expr  -- each
    | SingleSelector "=>" Expr  -- selector
    | ident "=>" Expr           -- fallback

  FallbackExpr = Chain ("??" Chain)?

  Chain = Source ChainStep*

  Source
    = "watch" Source                                       -- watch
    | "await" "(" selectorBody ")" Source                 -- awaitCond
    | "await" Source                                       -- awaitSelf
    | "@" ident EachSelector                              -- aliasEach
    | "@" ident SingleSelector                            -- aliasSingle
    | "@" ident                                           -- aliasRef
    | "@" ~alnum                                          -- rootRef
    | EachZip
    | EachSelector
    | SingleSelector
    | PositionalRef
    | ContextRef
    | FuncCall                                            -- funcCall
    | Literal                                             -- literal
  ContextRef = "$" ~"$" ~"(" ~alnum ~digit
  PositionalRef = "$" digit+

  EachZip        = "$$" "(" Expr ("," Expr)+ ","? ")"
  EachSelector   = "$$" "(" selectorBody ")" "+"?
  SingleSelector = "$"  "(" selectorBody ")" (~"??" "?")?

  selectorBody = selectorChar*
  selectorChar =
    "\"" (~"\"" any)* "\""     -- doubleStr
    | "'" (~"'" any)* "'"        -- singleStr
    | "(" selectorBody ")"       -- nested
    | ~")" any                   -- other

  ChainStep
    = PipeTransform
    | Block
    | Conditional
    | ScopedExpr

  ScopedExpr = ".(" Expr ")"

  Block = "{" ListOf<Field, ","?> ","? "}"

  PipeTransform = "|" ident ("(" ListOf<PipeArg, ","> ")")?

  PipeArg
    = ident ":" stringLit  -- kwarg
    | ident ":" integer    -- kwargInt
    | stringLit            -- string
    | integer              -- integer
    | ident                -- ident

  Conditional
    = ~"??" "?" Expr ":" Expr  -- full
    | ~"??" "?" Expr           -- partial

  Literal
    = stringLit  -- string
    | number     -- number
    | "null"     -- null
    | "true"     -- true
    | "false"    -- false

  stringLit
    = "\"" doubleStringChar* "\""  -- double
    | "'" singleStringChar* "'"    -- single

  doubleStringChar
    = "\\" any   -- escaped
    | ~"\"" any  -- other

  singleStringChar
    = "\\" any  -- escaped
    | ~"'" any  -- other

  number  (a number)  = digit+
  integer (an integer) = digit+

  ident = (letter | "_") (alnum | "_" | "-")*

  space += "//" (~"\n" any)*  -- lineComment
}
