{
  "showcase": $$(.vitrin-list > li:has(a[href*="/ilan/"])) {
    "title": $(a > span) | text,
    "url": $(a) | attr(href) | url,
    "image": $(a picture.s-picture img.s-image) | media ?? $(a > img) | media
  },

  "interestingAds": $$(#interestingAds > li) {
    "title": $(a > span) | text,
    "url": $(a) | attr(href) | url,
    "image": $(a > img) | media
  },

  "realEstateProjects": $$(.estate-projects .projects) {
    "id": $ | data(id),
    "name": $(.project-name > a) | text,
    "url": $(a) | attr(href) | url,
    "image": $(a > img) | media,
    "location": $(.info > .location) | text | trim,
    "deliveryDate": $(.info > .project-date) | text | trim
  }
}
