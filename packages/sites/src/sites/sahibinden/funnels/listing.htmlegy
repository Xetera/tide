---
name: "Listing Page"
url: "/ilan/:id/detay"
---
[
  {
    "_entity": match $([data-search-type="category/category_breadcrumb"] a)
      | attr("title") {
      "Emlak" => "@sahibinden/real_estate",
      "Vasıta" => "@sahibinden/vehicle",
      "Yedek Parça, Aksesuar, Donanım & Tuning" => "@sahibinden/accessories",
      _ => "@sahibinden/listing"
    },
    "_id": $(.classifiedId) | data("classifiedid") ?? $(#classifiedId) | text,
    "name": $(.classifiedDetailTitle h1) | text | trim,
    // the money here COULD be in euros or dollars.
    // The parser automatically handles that
    "price": $(.classified-price-wrapper) | text | money,
    "description": $(#classifiedDescription) | rich_text,
    "location": $(h2:has([data-click-label^="Adres"])) {
      "city": $$(a) | at(0) | text | trim,
      "town": $$(a) | at(1) | text | trim,
      "quarter": $$(a) | at(2) | text | trim
    },
    "attributes": $$(.classifiedInfoList li, .classified-info-list li) {
      [$(strong) | text | trim]: $(span) | text | trim
    }
      | merge,
    ($(#gmap) {
      "latitude": $ | data("lat") | number(locale: "en"),
      "longitude": $ | data("lon") | number(locale: "en")
    }),
    "breadcrumbs": $$([data-search-type="category/category_breadcrumb"] .bc-item > a)+ {
      "label": $ | text | trim
    },
    "images": match {
      // mobile
      $$([data-extra-class="mega-image"] ul > li) => {
        "_type": "image",
        "url": $(source[type="image/png"]) | attr("srcset") | url
      }
      // desktop
      $$(.megaPhotoThmbItem) => {
        "_type": "image",
        "url": $(img) | data("source") | url
      }
    }
  },
  $(.classifiedUserBox:has(.storeInfo)) {
    "_entity": "@sahibinden/agency",
    "_id": $(.storeBox a) | attr("href") | url,
    "name": $(.storeInfo) | text | trim,
    "link": $(.storeBox a) | attr("href") | url,
    "logo": $(img) | media
  }
]
