---
name: "Map Hover"
method: GET
url: "/ajax/mapSearch/classified/markers/:id"
---
[
  /* Map the main listing entity */
  {
    "_entity":  "@sahibinden/real_estate",
    "_id": $string(id),
    "name": title,
    "price": $money(price, 'TRY', 'tr'),
    "latitude": lat,
    "longitude": lon,
    "attributes": attributes
  }
]
