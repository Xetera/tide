---
name: "Map"
method: GET
url: "/ajax/mapSearch/classified/markers"
---

(
  /* doing a conversion a single time here is easier
     even though the "for sale" array isn't
     normally big enough to warrant it */
  $featured := $merge(bigRowClassifieds.{$string($): true});

  [
    classifiedMarkers.{
      "_entity": "@sahibinden/real_estate",
      "_id": id,
      "latitude": lat,
      "longitude": lon,
      "breadcrumbs": $$.breadcrumb[].{
        "id": id,
        "label": label
      },
      "price": $money(formattedPrice, {"currency": "TRY", "locale": "tr"}) ~> $sahibinden.precision,
      "isFeatured": $lookup($featured, id) ? true : false
    }
  ]
)
