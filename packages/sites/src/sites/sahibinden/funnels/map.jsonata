---
name: "Map"
method: GET
url: "/ajax/mapSearch/classified/markers"
---
[
  classifiedMarkers.{
    "_entity": "@sahibinden/listing",
    "_id": id,
    "latitude": lat,
    "longitude": lat,
    "breadcrumbs": $$.breadcrumb[].{
      "id": id,
      "label": label
    },
    "price": $money(formattedPrice, 'TRY', 'tr')
  }
]
