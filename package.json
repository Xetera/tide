{
  "name": "tide",
  "version": "0.0.3",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "cd gleam && gleam build --target javascript",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "oxlint --fix && oxfmt --write .",
    "test": "vitest --no-isolate",
